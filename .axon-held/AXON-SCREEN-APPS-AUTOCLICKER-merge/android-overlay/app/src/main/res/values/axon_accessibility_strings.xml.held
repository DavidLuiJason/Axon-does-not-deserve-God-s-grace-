<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="axon_accessibility_description">AXON reads what is on your screen (text, buttons and fields) when you ask it to. It can also tap, swipe, scroll and type for you, but only for plain navigation or actions you approve, and a red STOP button stays on screen while it works. Only when you ask, it takes a screenshot that stays in memory, or records your taps by label. It never reads or types into password fields.</string>
</resources>
